# منفذ الخادم
PORT=3000

# سر توقيع الجلسات (JWT) — غيّره في بيئة الإنتاج إلى قيمة عشوائية طويلة
JWT_SECRET=change-me-to-a-long-random-secret
TOKEN_TTL=30d

# بيانات حساب المدير الافتراضي (يُنشأ مرة واحدة عند أول تشغيل)
MANAGER_USERNAME=manager
MANAGER_PASSWORD=manager123

